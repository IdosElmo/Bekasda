# Supabase project credentials (Project Settings → API)
# Without these the app still works in "local device" mode (pass-and-play on one browser).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Public half of the VAPID keypair for Web Push notifications (optional).
# Generate a pair with: npx web-push generate-vapid-keys
# The PRIVATE key goes only into the Supabase Edge Function secrets.
# VITE_VAPID_PUBLIC_KEY=BM...

# Base path for the built site. Default is /Bekasda/ (GitHub Pages project site).
# Set to / when serving from a custom domain.
# VITE_BASE_PATH=/Bekasda/
